<Window x:Class="AgyPetsOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Antigravity Pet Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged">

    <Grid Margin="10">
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
            <!-- Usage popover above the pet -->
            <StackPanel x:Name="SpeechBubble"
                        Visibility="Collapsed"
                        Margin="0,0,0,6"
                        Cursor="Hand"
                        MouseLeftButtonDown="SpeechBubble_MouseLeftButtonDown">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="BubbleTranslate" Y="0" />
                </StackPanel.RenderTransform>
                <Border Width="292"
                        Padding="14,12,14,14"
                        CornerRadius="12"
                        Background="#F518181B"
                        BorderBrush="#24FFFFFF"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.52" Color="#000000" />
                    </Border.Effect>
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock x:Name="BubbleTitle"
                                           Text="Usage limits"
                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="#F3F3F4" />
                                <TextBlock x:Name="BubbleSub"
                                           Text="Checking…"
                                           Margin="0,2,0,0"
                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                           FontSize="10.5"
                                           Foreground="#9B9BA4" />
                            </StackPanel>
                            <Border DockPanel.Dock="Right"
                                    VerticalAlignment="Top"
                                    Margin="10,0,0,0"
                                    Padding="6,2"
                                    CornerRadius="5"
                                    Background="#18FFFFFF">
                                <TextBlock Text="×"
                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#9B9BA4" />
                            </Border>
                        </DockPanel>

                        <TextBlock x:Name="BubbleStatus"
                                   Visibility="Collapsed"
                                   Margin="0,10,0,0"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="11"
                                   Foreground="#C9C9CF"
                                   TextWrapping="Wrap" />

                        <ItemsControl x:Name="ModelsList" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,9">
                                        <DockPanel LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding PercentText}"
                                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding TextBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="6,0,0,0" />
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding ResetText}"
                                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                                       FontSize="10"
                                                       Foreground="#9B9BA4"
                                                       VerticalAlignment="Center"
                                                       Margin="6,0,0,0" />
                                            <TextBlock Text="{Binding Label}"
                                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                                       FontSize="11"
                                                       FontWeight="Medium"
                                                       Foreground="#F3F3F4"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                        </DockPanel>
                                        <Grid Height="4" Width="262" HorizontalAlignment="Left" Margin="0,5,0,0">
                                            <Border CornerRadius="2" Background="#2C2C31" />
                                            <Border CornerRadius="2"
                                                    Background="{Binding BarBrush}"
                                                    HorizontalAlignment="Left"
                                                    Width="{Binding BarWidth}" />
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Path Data="M 0,0 L 6,6 L 12,0 Z"
                      Fill="#F518181B"
                      HorizontalAlignment="Center"
                      Margin="0,-1,0,0" />
            </StackPanel>

            <!-- Pet Sprite -->
            <Image x:Name="PetImage"
                   Width="96"
                   Height="104"
                   Stretch="Fill"
                   HorizontalAlignment="Center"
                   Cursor="Hand"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                   MouseLeftButtonDown="PetImage_MouseLeftButtonDown"
                   MouseMove="PetImage_MouseMove"
                   MouseLeftButtonUp="PetImage_MouseLeftButtonUp">
                <Image.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Usage limits" Click="CheckUsageMenuItem_Click" />
                        <Separator />
                        <MenuItem Header="Close overlay" Click="CloseOverlayMenuItem_Click" />
                    </ContextMenu>
                </Image.ContextMenu>
            </Image>
        </StackPanel>
    </Grid>
</Window>
